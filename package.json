{
  "name": "cypress-multithreaded-runner",
  "version": "1.32.0",
  "description": "A lightweight method to run Cypress spec files in multiple threads, with built-in support for Allure report generation",
  "main": "index.js",
  "files": [
    "index.js",
    "async.js",
    "allure.js",
    "allure/",
    "lib/"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:all": "npm run lint && npm test && npm run test:integration",
    "clean:artifacts": "node -e \"require('fs').rmSync('test-artifacts', { recursive: true, force: true })\""
  },
  "author": "Ben Cheshire",
  "peerDependencies": {
    "cypress": ">=15"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benchesh/cypress-multithreaded-runner.git"
  },
  "dependencies": {
    "@benchesh/allure-cypress": "^3.15.0-retries.1",
    "allure-commandline": "^2.46.2",
    "esbuild": "^0.28.2",
    "fs-extra": "^11.4.1",
    "junit-report-merger": "^9.0.4",
    "kill-sync": "^1.0.4",
    "lodash": "^4.18.1",
    "node-html-parser": "^9.0.7",
    "node-notifier": "^12.1.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "cypress": "^16.4.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
